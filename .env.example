# Secret key. sk_test_ works as-is. sk_live_ also needs PAYSTACK_ALLOW_LIVE_KEY=true.
# pk_ (public) and rk_ (restricted) keys are refused.
PAYSTACK_SECRET_KEY=
# PAYSTACK_ALLOW_LIVE_KEY=false

# Origin only. Defaults to https://api.paystack.co. http is allowed only for loopback,
# and a loopback base URL never accepts sk_live_.
# PAYSTACK_BASE_URL=https://api.paystack.co

# Exact string true is required. Anything else keeps writes and money actions as previews.
PAYSTACK_ALLOW_WRITES=false
PAYSTACK_ALLOW_MONEY_MOVEMENT=false

PAYSTACK_PER_MINUTE=60
PAYSTACK_TIMEOUT_MS=20000
PAYSTACK_CACHE_TTL_SEC=0
PAYSTACK_CONTACT=contact@example.com

# MCP_TRANSPORT=stdio
# PORT=3000
